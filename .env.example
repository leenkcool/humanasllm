# 服务配置
PORT=39000
NODE_ENV=production

# 数据库（PostgreSQL 5433）
DB_TYPE=pg
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=p390
PG_USER=postgres
PG_PASSWORD=change-me

# JWT
JWT_SECRET=please-change-to-random-string

# 人工代理网关
HUMAN_LLM_MODEL=human-llm
# 上游调用网关的 API-Key（配置后 /v1 需带 Authorization: Bearer <key>）
# UPSTREAM_API_KEY=sk-your-upstream-key
# 任务超时（分钟）
TASK_PENDING_TIMEOUT_MIN=60
TASK_PROCESSING_TIMEOUT_MIN=120
# /v1 挂起等待上限（毫秒）
# TASK_WAIT_MS=300000

# AI 降级路由（DeepSeek）
AI_RELAY_ENABLED=true
AI_RELAY_BASE_URL=https://api.deepseek.com
# AI_RELAY_API_KEY=sk-your-deepseek-key
AI_RELAY_MODELS=deepseek-v4-flash

# 上游完成回调（任务终态主动 POST 结果到请求里的 callback_url，上游免轮询）
CALLBACK_ENABLED=true
CALLBACK_TIMEOUT_MS=5000
# SSE 中途状态推送（stream:true + stream_events:true 时生效）：保活间隔 / 最长保持分钟
SSE_HEARTBEAT_MS=15000
SSE_EVENTS_MAX_MIN=60

# 注册模式：open=注册即用 / audit=管理员审核启用
USER_REGISTER_MODE=open
# SMTP 邮件（未配置时密码重置链接写入服务端日志，请联系管理员获取）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 限流
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=2000
RATE_LIMIT_LOGIN_MAX=5

# 监控（Prometheus）
METRICS_ENABLED=true
# 配置后 /metrics 需 Authorization: Bearer <token>；留空则内网匿名可读
# METRICS_TOKEN=

# 数据备份
# 备份目录（相对项目根或绝对路径，默认 data/backups）
# BACKUP_DIR=data/backups
# 保留最近 N 份（默认 14；.sql.gz 与 .files 各算一份）
BACKUP_KEEP=14
# PostgreSQL 客户端 bin 目录（Windows 上常在 PATH 之外，必须时指定；版本须 >= 服务端）
# PG_BIN=D:\Program Files\PostgreSQL\18\bin

# 智能派单 / 告警
# DISPATCH_ENABLED=true
# DISPATCH_LOAD_CAP=5
# ESCALATE_INTERVAL_MIN=30
# APPROVAL_OVERDUE_HOURS=24
# 告警回溯窗口（天）：只对 N 天内创建的任务升级告警，0 = 不限制（首次启用避免历史任务告警风暴）
# ALERT_BACKFILL_DAYS=7
# ALERT_SCAN_LIMIT=500
# WORKBENCH_URL=http://192.168.168.3:39000/login.html

# 对外访问地址（反代 / 密码重置链接 / PWA 深链）
# PUBLIC_BASE_URL=https://your.domain

# 答复审核 / 知识库 / 效果回流
# 审核策略固定为「单人审核 + confidential 抽检」，无需配置
# 知识库相似度阈值（pg_trgm，0~1，默认 0.05，中文短语偏低）
# KB_SIMILARITY_MIN=0.05
# 上游反馈未解决时的自动重开窗口（天，默认 7）
# FEEDBACK_REOPEN_DAYS=7
